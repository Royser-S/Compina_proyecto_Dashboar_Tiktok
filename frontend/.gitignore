# ------------------------------------
# SEGURIDAD (¡MUY IMPORTANTE!)
# ------------------------------------
.env
.env.local
.env.*.local

# ------------------------------------
# PYTHON / BACKEND
# ------------------------------------
# Entornos virtuales (posibles nombres)
venv/
env/
api/venv/

# Archivos compilados y cache de Python
*.pyc
__pycache__/
*.pyo
*.pyd
.pytest_cache/

# Base de datos local (si usas SQLite)
*.sqlite
*.sqlite3
db.sqlite3

# Archivos de datos (Reportes Excel/CSV que descargas)
# Esto evita subir datos de clientes al repositorio
*.xlsx
*.xls
*.csv

# ------------------------------------
# FRONTEND (React/Vite)
# ------------------------------------
frontend/node_modules/
node_modules/

# Archivos de construcción (Build)
frontend/dist/
frontend/build/
frontend/out/

# Cache y logs
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# NOTA: He eliminado 'package-lock.json' de aquí. 
# DEBES subirlo para que Vercel funcione correctamente.

# ------------------------------------
# SISTEMA / IDE
# ------------------------------------
.DS_Store
.vscode/
.idea/
Thumbs.db